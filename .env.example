# OCTALLION — Environment Variables
# Copy this to .env and fill in your values

BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional tuning
ALERT_THRESHOLD=5         # cents move that triggers a watchlist alert
DAILY_HOUR=8              # UTC hour for daily summary

# Autonomous agent
AGENT_INTERVAL=3600       # seconds between autonomous news+market scans
AGENT_CHAT_ID=            # Telegram chat ID to receive agent reports (leave blank to disable)
